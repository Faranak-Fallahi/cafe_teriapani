VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Optional PocketBase URL used only by the local seed script.
POCKETBASE_URL=http://127.0.0.1:8090

# Used only by the local seed script. Keep these server-side and never prefix them with VITE_.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Optional. Set to true only when intentionally overwriting matching sample records on a remote database.
POCKETBASE_ALLOW_SAMPLE_OVERWRITE=false
